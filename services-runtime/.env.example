# CoreMesh AI — Runtime Environment Variables
# Module: example runtime process configuration.
# Role: documents environment names consumed by src.config.Settings.
# Dependencies: copied to services-runtime/.env or exported to the process.
# Side effects: none as checked in; real API keys enable external calls and
# configured paths/URLs can create local or remote persistent state.
#
# Copy this file to .env and fill in your values before starting the service.

# ---------------------------------------------------------------------------
# OpenAI API (required for LLM extraction + vision fallback)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Model selection
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ARBITRATION_MODEL=gpt-4o-mini
OPENAI_ADJUDICATOR_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Arbitration critics (Project 5)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_ARBITRATION_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ARBITRATION_MODEL=llama3.1
ARBITRATION_SCORE_THRESHOLD=4
ARBITRATION_RETRY_ATTEMPTS=2
ARBITRATION_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# OCR settings
# ---------------------------------------------------------------------------

# Variance threshold (0.0–1.0): if tesseract/easyocr disagree more than this,
# the vision LLM fallback is invoked.  Default: 0.08 (8%)
OCR_VARIANCE_THRESHOLD=0.08

# Path to the Tesseract binary.  Leave empty to use the system PATH.
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Path to the Poppler bin/ directory (Windows only; leave empty on Linux/macOS).
# Windows example: C:/Program Files/poppler-24.02.0/Library/bin
POPPLER_PATH=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgresql://coremesh:coremesh_secret@localhost:5432/coremesh
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=coremesh_chunks
QDRANT_VECTOR_SIZE=1536
RERANKER_MODEL=BAAI/bge-reranker-large

# Agent supervisor memory
CHROMA_PERSIST_DIRECTORY=.chroma/coremesh-agents
CHROMA_COLLECTION=coremesh_agent_memory
AGENT_MEMORY_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Failure forensics (Project 3)
# ---------------------------------------------------------------------------
# Every orchestration trace is written as redacted JSON and indexed in SQLite.
# Set OTEL_EXPORTER_OTLP_ENDPOINT separately to fan spans out to an OTLP backend.
FORENSICS_ENABLED=true
FORENSICS_TRACE_DIRECTORY=.traces
FORENSICS_REGISTRY_PATH=.traces/registry.sqlite3
FORENSICS_CONFIDENCE_THRESHOLD=0.60
FORENSICS_CONFIDENCE_DROP_THRESHOLD=0.20
FORENSICS_MAX_ATTRIBUTE_LENGTH=256

# ---------------------------------------------------------------------------
# Hybrid retrieval tuning (RRF fusion + reranker)
# ---------------------------------------------------------------------------
# RRF weights applied to dense (vector) vs sparse (BM25) rank contributions.
# Equal weights (1.0 / 1.0) reproduce plain unweighted RRF. To bias toward
# semantic recall, e.g. use 0.7 / 0.3.
RAG_DENSE_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0

# When true, exact technical-identifier matches (e.g. CircuitBreakerState.OPEN)
# are promoted ahead of the cross-encoder score as a deterministic tie-breaker.
# Set false to rank purely by the reranker.
RAG_KEYWORD_PRIORITY=true
