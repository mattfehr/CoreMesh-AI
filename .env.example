# CoreMesh single-host Compose configuration.
# Copy this file to .env, set POSTGRES_PASSWORD, and keep .env out of version control.

# Required database identity. POSTGRES_PASSWORD must not be blank.
POSTGRES_USER=coremesh
POSTGRES_PASSWORD=
POSTGRES_DB=coremesh

# Host exposure. Loopback is the safe local/demo default.
COREMESH_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
REDISINSIGHT_HOST_PORT=8001
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
RUNTIME_HOST_PORT=8000
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
VITE_GATEWAY_BASE_URL=http://localhost:8080

# Optional alternate build contexts.
COREMESH_RUNTIME_CONTEXT=./services-runtime
COREMESH_GATEWAY_CONTEXT=./gateway-proxy
COREMESH_FRONTEND_CONTEXT=./frontend-ui
COREMESH_ANALYTICS_CONTEXT=./analytics-workers

# External providers. Blank secrets keep credentials out of the example.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ARBITRATION_MODEL=gpt-4o-mini
OPENAI_ADJUDICATOR_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_ARBITRATION_MODEL=claude-3-5-sonnet-latest
RUNTIME_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ARBITRATION_MODEL=llama3.1

# Runtime arbitration. Deterministic mode is intended for local validation/CI.
ARBITRATION_MODE=external
ARBITRATION_SCORE_THRESHOLD=4
ARBITRATION_RETRY_ATTEMPTS=2
ARBITRATION_TIMEOUT_SECONDS=30

# OCR. Disable EasyOCR to avoid its model download in hermetic validation.
OCR_VARIANCE_THRESHOLD=0.08
OCR_EASYOCR_ENABLED=true
TESSERACT_CMD=
POPPLER_PATH=

# Hybrid RAG. hash/lexical are credential-free validation providers.
QDRANT_COLLECTION=coremesh_chunks
QDRANT_VECTOR_SIZE=1536
RERANKER_MODEL=BAAI/bge-reranker-large
RAG_EMBEDDING_PROVIDER=openai
RAG_RERANKER_PROVIDER=cross_encoder
RAG_DENSE_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0
RAG_KEYWORD_PRIORITY=true

# Runtime memory, forensics, and privacy-approved interaction logging.
CHROMA_COLLECTION=coremesh_agent_memory
AGENT_MEMORY_TTL_SECONDS=3600
FORENSICS_ENABLED=true
FORENSICS_CONFIDENCE_THRESHOLD=0.60
FORENSICS_CONFIDENCE_DROP_THRESHOLD=0.20
FORENSICS_MAX_ATTRIBUTE_LENGTH=256
PRODUCTION_INTERACTION_LOGGING_ENABLED=false
PRODUCTION_LOG_REDACTION_PATTERNS=[]
PRODUCTION_LOG_CONNECT_TIMEOUT_SECONDS=3
PRODUCTION_LOG_STATEMENT_TIMEOUT_MS=3000
COREMESH_CHAT_STUB=false
OTEL_SERVICE_NAME=coremesh-runtime
OTEL_EXPORTER_OTLP_ENDPOINT=

# Gateway admission, resilience, and experiment routing.
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SECOND=20
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW=30s
CIRCUIT_OPEN_DURATION=30s
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTOPILOT_ENABLED=true
AUTOPILOT_TIER1_MODEL=gpt-4o-mini
AUTOPILOT_TIER3_MODEL=gpt-4o
AUTOPILOT_EXPERIMENT_FLAG=cost_autopilot_routing
AUTOPILOT_EXPERIMENT_LOOKUP_TIMEOUT=2s
AUTOPILOT_DEBUG=false

# Gateway semantic cache. hash is the credential-free validation provider.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_EMBEDDING_PROVIDER=openai
SEMANTIC_CACHE_THRESHOLD=0.96
SEMANTIC_CACHE_TTL=24h
SEMANTIC_CACHE_INDEX=coremesh_semantic_cache
SEMANTIC_CACHE_KEY_PREFIX=coremesh:semantic:entry:
SEMANTIC_CACHE_VECTOR_DIM=1536

# PostgreSQL-backed production log miner (analytics profile).
LOG_MINER_EMBEDDING_MODEL=text-embedding-3-small
LOG_MINER_REFERENCE_MODEL=gpt-4o
LOG_MINER_EMBEDDING_BATCH_SIZE=128
LOG_MINER_PROVIDER_RETRY_ATTEMPTS=3
LOG_MINER_WINDOW_DAYS=30
LOG_MINER_RETENTION_DAYS=30
LOG_MINER_SCORE_THRESHOLD=4
LOG_MINER_MIN_CLUSTER_SIZE=3
LOG_MINER_MIN_SAMPLES=2
LOG_MINER_CLUSTER_METRIC=euclidean
LOG_MINER_CLUSTER_SELECTION_METHOD=eom
LOG_MINER_MAX_NOISE_PER_FEATURE=20
LOG_MINER_MAX_CLUSTER_EXAMPLES=3
LOG_MINER_PROMOTION_CONFIDENCE=0.80
LOG_MINER_FINGERPRINT_VERSION=1.0
LOG_MINER_LEASE_TTL_SECONDS=300
LOG_MINER_HEARTBEAT_INTERVAL_SECONDS=60
LOG_MINER_CRON=0 2 * * *
LOG_MINER_TIMEZONE=UTC
