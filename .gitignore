# Module: repository-local ignore policy.
# Role: keeps generated artifacts, local credentials, caches, and editor state
# out of CoreMesh source control.
# Dependencies: interpreted by Git and tools that honor .gitignore syntax.
# Side effects: matching untracked paths are hidden from normal Git status and
# add operations; already-tracked files are unaffected.

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.chroma/
.traces/
htmlcov/
.coverage
*.coveragerc

# Go
gateway-proxy/vendor/
gateway-proxy/*.exe
gateway-proxy/*.test
gateway-proxy/*.out

# Environment
.env
.env.*
!.env.example
*.secret
plan/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.log

# Node (if any tooling is added)
node_modules/
