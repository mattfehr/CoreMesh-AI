# Phase 4.1 production log-miner host-development configuration.
# Copy to .env, replace CHANGE_ME, and never commit real credentials.

POSTGRES_DSN=postgresql://coremesh:CHANGE_ME@localhost:5432/coremesh
OPENAI_API_KEY=
LOG_MINER_EMBEDDING_MODEL=text-embedding-3-small
LOG_MINER_REFERENCE_MODEL=gpt-4o
LOG_MINER_EMBEDDING_BATCH_SIZE=128
LOG_MINER_PROVIDER_RETRY_ATTEMPTS=3
LOG_MINER_WINDOW_DAYS=30
LOG_MINER_RETENTION_DAYS=30
LOG_MINER_SCORE_THRESHOLD=4
LOG_MINER_MIN_CLUSTER_SIZE=3
LOG_MINER_MIN_SAMPLES=2
LOG_MINER_CLUSTER_METRIC=euclidean
LOG_MINER_CLUSTER_SELECTION_METHOD=eom
LOG_MINER_MAX_NOISE_PER_FEATURE=20
LOG_MINER_MAX_CLUSTER_EXAMPLES=3
LOG_MINER_PROMOTION_CONFIDENCE=0.80
LOG_MINER_FINGERPRINT_VERSION=1.0
LOG_MINER_LEASE_TTL_SECONDS=300
LOG_MINER_HEARTBEAT_INTERVAL_SECONDS=60
LOG_MINER_CRON=0 2 * * *
LOG_MINER_TIMEZONE=UTC

# Phase 4.3 fine-tuner credentials. The JSON config remains non-secret and the
# default Meta Llama model is gated.
HF_TOKEN=
WANDB_API_KEY=
